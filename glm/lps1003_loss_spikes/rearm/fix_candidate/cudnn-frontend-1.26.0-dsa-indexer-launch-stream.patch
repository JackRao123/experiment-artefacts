+# Dedicated per-device launch streams (LPS-1003). The compiled kernel and its
+# -inf prefill must not run on the legacy default stream: with
+# CUDA_DEVICE_MAX_CONNECTIONS unset, default-stream work around the DSL
+# launch loses inter-op ordering with it, and the prefill can land AFTER the
+# kernel's stores, erasing freshly-written scores (whole packed-row halves
+# read back as -inf; downstream top-k then selects garbage KV). Running the
+# prefill + launch on an explicit stream, event-chained to the caller's
+# stream, restores ordering without any serialization. Verified A/B on
+# GLM-5.2-FP8 cp16 262k, B300: default-stream arrangement corrupts 8/8
+# cold-start reps; this arrangement 0/8, bitwise-stable outputs.
+_kernel_streams: dict = {}
 
+
+def _get_kernel_stream(device) -> "torch.cuda.Stream":
+    s = _kernel_streams.get(device)
+    if s is None:
+        s = torch.cuda.Stream(device=device)
+        _kernel_streams[device] = s
+    return s
+
