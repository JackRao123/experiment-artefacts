        if "NCCL_COLLNET_ENABLE" in os.environ:
            del os.environ["NCCL_COLLNET_ENABLE"]
    
        if use_sharp:
            if sharp_enabled_group is None:
                # By default, SHARP is enabled from dp group.
                sharp_enabled_group = "dp"
            else:
