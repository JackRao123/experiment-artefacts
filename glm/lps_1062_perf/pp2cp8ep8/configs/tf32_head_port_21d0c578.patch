+class _TF32FrozenLinear(torch.autograd.Function):
+    """fp32 projection through a frozen weight on TF32 tensor cores.
+
+    The fp32 head's inputs are exact bf16 upcasts (8-bit mantissa), which
+    TF32's 10-bit mantissa represents exactly, and cuBLAS TF32 kernels
+    accumulate in fp32 - every product is exact and only the summation order
+    can differ from the fp32 SIMT kernel. Moves the vocab-sized GEMM from
+    CUDA cores to tensor cores. The weight is frozen (LoRA base): backward
+    returns no weight grad and runs only the dgrad GEMM, also under TF32.
+    """
+
+    @staticmethod
+    def forward(ctx, hidden, weight):
+        ctx.save_for_backward(weight)
+        prev = torch.backends.cuda.matmul.allow_tf32
+        torch.backends.cuda.matmul.allow_tf32 = True
+        try:
+            return torch.nn.functional.linear(hidden, weight)
+        finally:
+            torch.backends.cuda.matmul.allow_tf32 = prev
+
+    @staticmethod
+    def backward(ctx, grad_out):
+        (weight,) = ctx.saved_tensors
+        prev = torch.backends.cuda.matmul.allow_tf32
+        torch.backends.cuda.matmul.allow_tf32 = True
+        try:
+            return grad_out @ weight, None
+        finally:
+            torch.backends.cuda.matmul.allow_tf32 = prev
+
+
+_tf32_logged = False
+
+
+def _tf32_head_enabled() -> bool:
+    enabled = os.environ.get("BT_TF32_LM_HEAD", "0") == "1"
+    global _tf32_logged
+    if enabled and not _tf32_logged:
+        print("TF32 LM-head fast path ACTIVE", flush=True)
+        _tf32_logged = True
+    return enabled
+
+
