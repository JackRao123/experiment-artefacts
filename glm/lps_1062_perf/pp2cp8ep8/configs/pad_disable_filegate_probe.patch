+"""Tests for the pad-disable sentinel valve (LPS-1062 fix-arm probe hunk).
+
+The valve lives in MegatronTrainingRunner._thd_partition_pad_to_length: the
+sentinel file forces unpadded partitions per pass, overriding the PP>1 gate
+and BT_PACK_PAD_TO_MAX. Both directions pinned.
+"""
+
+from __future__ import annotations
+
+from unittest.mock import Mock
+
+import pytest
+
+pytest.importorskip("megatron.bridge")
+
+from trainers_server.dp_worker.backends.megatron_bridge import training_runner
+from trainers_server.dp_worker.backends.megatron_bridge.training_runner import (
+    MegatronTrainingRunner,
+)
+
+
+def _runner(pipeline_parallel_world_size: int) -> MegatronTrainingRunner:
+    runner = MegatronTrainingRunner.__new__(MegatronTrainingRunner)
+    runner._pipeline_parallel_world_size = pipeline_parallel_world_size
+    runner._config = Mock(max_seq_len=131072)
+    return runner
+
+
+def test_sentinel_present_forces_unpadded_under_pp2(
+    monkeypatch: pytest.MonkeyPatch, tmp_path
+) -> None:
+    sentinel = tmp_path / "bt_pack_pad_to_max.off"
+    monkeypatch.setattr(training_runner, "_PAD_TO_MAX_KILL_FILE", str(sentinel))
+    runner = _runner(pipeline_parallel_world_size=2)
+    assert runner._thd_partition_pad_to_length() == 131072  # gate applies
+    sentinel.touch()
+    assert runner._thd_partition_pad_to_length() is None  # valve overrides
+
+
+def test_sentinel_absent_preserves_gate_behavior(
+    monkeypatch: pytest.MonkeyPatch, tmp_path
+) -> None:
+    monkeypatch.setattr(
+        training_runner, "_PAD_TO_MAX_KILL_FILE", str(tmp_path / "absent")
+    )
+    assert _runner(2)._thd_partition_pad_to_length() == 131072  # PP2 pads by gate
+    assert _runner(1)._thd_partition_pad_to_length() is None  # PP1 default unpadded
