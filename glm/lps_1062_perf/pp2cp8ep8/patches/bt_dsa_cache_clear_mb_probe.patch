+    ]:
+        _cleared = []
+        for _modname, _attr in [
+            ("cudnn.deepseek_sparse_attention.indexer_forward._interface", "_compile_cache"),
+            ("cudnn.deepseek_sparse_attention.indexer_forward._interface_sm90", "_compile_cache"),
+            ("cudnn.deepseek_sparse_attention.indexer_top_k.api", "_cache_of_IndexerTopKObjects"),
+            ("cudnn.deepseek_sparse_attention.indexer_top_k.compactify", "_compile_cache"),
+        ]:
+            try:
