  BT_TRAINER_CONFIG_PATH=<your config .json on /root/.cache/user_artifacts> bash /root/.cache/user_artifacts/.devbox_up/start_trainer.sh
  # configs: see /root/.cache/user_artifacts/trainers_main/examples/trainer-configs/ (weight_sync type=local)
  # health : curl -sf http://127.0.0.1:8001/health ; status: curl -s http://127.0.0.1:8001/status
  # wait   : bash /root/.cache/user_artifacts/.devbox_up/wait_trainer_health.sh  (background)
  # stop   : bash /root/.cache/user_artifacts/.devbox_up/stop_trainer.sh

--- SINGLE-NODE SAMPLER (port 8000; run on any node) -----------------------
  ssh tj-w56lorq
  MODEL_PATH=<hf id or weights path> bash /root/.cache/user_artifacts/.devbox_up/start_sampler.sh
  # health : curl -sf http://127.0.0.1:8000/health
  # wait   : bash /root/.cache/user_artifacts/.devbox_up/wait_sampler_health.sh  (background)
  # stop   : bash /root/.cache/user_artifacts/.devbox_up/stop_sampler.sh

--- HOUSEKEEPING -----------------------------------------------------------
  stop box     : truss train stop --remote baseten --job-id w56lorq
  job logs     : truss train logs --remote baseten --job-id w56lorq --tail
