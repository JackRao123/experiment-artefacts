diff --git a/server-megatron-bridge/src/trainers_server_megatron_bridge/nvtx_ranges.py b/server-megatron-bridge/src/trainers_server_megatron_bridge/nvtx_ranges.py
new file mode 100644
index 000000000..3093c2024
--- /dev/null
+++ b/server-megatron-bridge/src/trainers_server_megatron_bridge/nvtx_ranges.py
@@ -0,0 +1,204 @@
+"""Coarse NVTX ranges for Nsight Systems attribution of one training step.
+
+The trainer has no step-level structure visible to ``nsys`` today: a capture is a
+flat list of ~150k kernels per rank, and attributing them to forward / backward /
+recompute / attention / MoE / HybridEP has to be reverse-engineered from kernel
+names. These ranges make the structure explicit. They are always on; an NVTX
+push/pop costs about a microsecond and is a no-op when no tool is attached, so a
+262k-token step (~3k ranges per rank) pays well under 10 ms.
+
+Two mechanisms:
+
+* Megatron-LM's own ``nvtx_range_push``/``nvtx_range_pop`` framework
+  (``self_attention``, ``mlp``, ``self_attn_bda``, ``mlp_bda`` ...) is enabled from
+  ``megatron_config.py`` via ``ProfilingConfig(nvtx_ranges=True)``.
+* Everything that framework does not cover is added here by wrapping the relevant
+  Python entry points with ``install_nvtx_patches()``. Wrapping is done on the class
+  or module attribute, so it reaches both the forward and (for
+  ``torch.autograd.Function`` subclasses) the backward side, and it works on the
+  recompute-forward that runs inside checkpoint backward. No submodule changes.
+
+Range names (what they contain):
+
+    request:<OpType>       one HTTP op on the DP worker (worker.py)
+    forward_backward       one forward_backward request inside the Megatron runner
+    forward / backward     Megatron schedule forward_step / backward_step (per microbatch)
+    optimizer              optimizer.step + scheduler + zero_grad_buffer
+    recompute              activation-checkpoint backward: re-runs the layer forward
+    layer:<n>              TransformerLayer.forward (also fires inside recompute)
+    attention              DSAttention.forward
+    dsa_indexer            DSA indexer (q/k projection + top-k selection)
+    dsa_core               the sparse attention kernel call
+    moe                    MoELayer.forward
+    moe_route / moe_dispatch / moe_experts / moe_combine / moe_shared_experts
+    hybridep_dispatch / hybridep_combine            forward-side all-to-all
+    hybridep_dispatch_bwd / hybridep_combine_bwd    backward-side all-to-all
+    lm_head / lm_head_gemm                          chunked output head (chunked_lm_head.py)
+"""
+
+from __future__ import annotations
+
+import contextlib
+import functools
+import logging
+from collections.abc import Callable, Iterator
+from typing import Any, cast
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+_NVTX_AVAILABLE = torch.cuda.is_available()
+
+
+@contextlib.contextmanager
+def nvtx_range(name: str) -> Iterator[None]:
+    """Push an NVTX range for the duration of the block (no-op without CUDA)."""
+    if not _NVTX_AVAILABLE:
+        yield
+        return
+    torch.cuda.nvtx.range_push(name)
+    try:
+        yield
+    finally:
+        torch.cuda.nvtx.range_pop()
+
+
+def nvtx_decorated(name: str) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
+    """Decorator form of :func:`nvtx_range` for functions and methods."""
+
+    def deco(fn: Callable[..., Any]) -> Callable[..., Any]:
+        @functools.wraps(fn)
+        def inner(*args: Any, **kwargs: Any) -> Any:
+            with nvtx_range(name):
+                return fn(*args, **kwargs)
+
+        return inner
+
+    return deco
+
+
+def _wrap(
+    owner: Any, attr: str, name_fn: Callable[..., str], *, static: bool = False
+) -> bool:
+    """Replace ``owner.attr`` with a version that runs inside an NVTX range.
+
+    ``name_fn`` receives the call's positional args (``self`` first for methods,
+    ``ctx`` first for autograd static methods) and returns the range name.
+    Returns False when the attribute does not exist, so callers can log gaps.
+    """
+    original = getattr(owner, attr, None)
+    if original is None:
+        return False
+    if getattr(original, "_bt_nvtx_wrapped", False):
+        return True
+    # For staticmethods on classes, getattr already returns the plain function.
+    target = original
+
+    @functools.wraps(target)
+    def wrapped(*args: Any, **kwargs: Any) -> Any:
+        with nvtx_range(name_fn(*args)):
+            return target(*args, **kwargs)
+
+    cast(Any, wrapped)._bt_nvtx_wrapped = True
+    setattr(owner, attr, staticmethod(wrapped) if static else wrapped)
+    return True
+
+
+def _const(name: str) -> Callable[..., str]:
+    return lambda *args: name
+
+
+def _layer_name(self: Any, *args: Any) -> str:
+    return f"layer:{getattr(self, 'layer_number', '?')}"
+
+
+_installed = False
+
+
+def install_nvtx_patches() -> None:
+    """Wrap Megatron-LM / TE entry points with NVTX ranges. Idempotent.
+
+    Every wrap is best-effort: a missing symbol is logged and skipped so a
+    Megatron/TE version bump never breaks trainer startup over profiling.
+    """
+    global _installed
+    if _installed:
+        return
+    _installed = True
+    missing: list[str] = []
+
+    def wrap(
+        module_path: str,
+        qualname: str,
+        name_fn: Callable[..., str],
+        *,
+        static: bool = False,
+    ) -> None:
+        try:
+            module = __import__(module_path, fromlist=["_"])
+            owner: Any = module
+            parts = qualname.split(".")
+            for part in parts[:-1]:
+                owner = getattr(owner, part)
+            if not _wrap(owner, parts[-1], name_fn, static=static):
+                missing.append(f"{module_path}:{qualname}")
+        except (
+            ImportError,
+            AttributeError,
+        ) as exc:  # pragma: no cover - vendored versions
+            missing.append(f"{module_path}:{qualname} ({exc})")
+
+    sched = "megatron.core.pipeline_parallel.schedules"
+    wrap(sched, "forward_step", _const("forward"))
+    wrap(sched, "backward_step", _const("backward"))
+
+    wrap(
+        "megatron.core.transformer.transformer_layer",
+        "TransformerLayer.forward",
+        _layer_name,
+    )
+
+    dsa = "megatron.core.transformer.experimental_attention_variant.dsa"
+    wrap(dsa, "DSAttention.forward", _const("attention"))
+    wrap(dsa, "DSAIndexer.forward", _const("dsa_indexer"))
+    wrap(dsa, "DSAIndexer.forward_before_topk", _const("dsa_indexer"))
+    wrap(dsa, "_run_sparse_attention", _const("dsa_core"))
+
+    moe = "megatron.core.transformer.moe.moe_layer"
+    wrap(moe, "MoELayer.forward", _const("moe"))
+    wrap(moe, "MoELayer.route", _const("moe_route"))
+    wrap(moe, "MoELayer.dispatch", _const("moe_dispatch"))
+    wrap(moe, "MoELayer.routed_experts_compute", _const("moe_experts"))
+    wrap(moe, "MoELayer.combine", _const("moe_combine"))
+    wrap(moe, "MoELayer.shared_experts_compute", _const("moe_shared_experts"))
+
+    disp = "megatron.core.transformer.moe.token_dispatcher"
+    wrap(disp, "_HybridEPManager.dispatch", _const("hybridep_dispatch"))
+    wrap(disp, "_HybridEPManager.combine", _const("hybridep_combine"))
+
+    a2a = "megatron.core.transformer.moe.fused_a2a"
+    wrap(a2a, "HybridEPDispatch.backward", _const("hybridep_dispatch_bwd"), static=True)
+    wrap(a2a, "HybridEPCombine.backward", _const("hybridep_combine_bwd"), static=True)
+
+    # Activation recompute: Megatron's checkpoint under bf16, TE's under fp8/fp4.
+    wrap(
+        "megatron.core.tensor_parallel.random",
+        "CheckpointFunction.backward",
+        _const("recompute"),
+        static=True,
+    )
+    wrap(
+        "transformer_engine.pytorch.distributed",
+        "_CheckpointFunction.backward",
+        _const("recompute"),
+        static=True,
+    )
+
+    if missing:
+        logger.info(
+            "NVTX patches installed; skipped unavailable targets: %s",
+            ", ".join(missing),
+        )
+    else:
+        logger.info("NVTX patches installed")
