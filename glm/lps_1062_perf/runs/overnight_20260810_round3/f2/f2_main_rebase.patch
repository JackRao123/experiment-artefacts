+def _phantom_partitions_enabled() -> bool:
+    """F2 kill-switch: phantom partition padding is ON unless explicitly disabled.
+
+    Default-on because it is a correctness fix (DP>1 THD-CP deadlocks without
+    it); ``BT_F2_PHANTOM_PARTITIONS=0`` exists for forensics/A-B only.
+    """
+    return os.environ.get("BT_F2_PHANTOM_PARTITIONS", "1") == "1"
+
+
+def _dp_max_partition_count(count: int) -> int:
+    """All-reduce MAX of the local THD-CP partition count across the pure-DP group.
+
+    Issued once per ``forward_backward`` op by every rank at the same call
+    site (before any partition runs), so it cannot interleave with the
+    per-partition EP collectives it protects. Guards mirror ``_dp_reduce_sum``:
+    identity without a process group or on a single-rank DP group.
+    """
+    if not torch.distributed.is_initialized():
+        return count
+    dp_group = mpu.get_data_parallel_group(with_context_parallel=False)
+    if torch.distributed.get_world_size(group=dp_group) == 1:
+        return count
+    device = (
+        torch.device(f"cuda:{torch.cuda.current_device()}")
+        if torch.cuda.is_available()
+        else torch.device("cpu")
+    )
+    t = torch.tensor([count], dtype=torch.long, device=device)
+    torch.distributed.all_reduce(t, op=torch.distributed.ReduceOp.MAX, group=dp_group)
+    return int(t.item())
+
