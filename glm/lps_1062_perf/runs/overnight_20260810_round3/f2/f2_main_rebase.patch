+# Zero-contribution values per loss-input key for phantom datums (F2). Every
+# THD-CP loss fn masks to an exact [0, 0] report with these: CE/DPO via
+# ``labels == -100`` / ``weights == 0``; the RL losses via
+# ``loss_mask = (advantages != 0) & (targets != -100)``.
+_PHANTOM_LOSS_INPUT_VALUES = {
+    "target_tokens": (-100, "int64"),
+    "weights": (0.0, "float32"),
+    "logprobs": (0.0, "float32"),
+    "advantages": (0.0, "float32"),
+    "temperatures": (1.0, "float32"),
+    "ref_logprobs": (0.0, "float32"),
+}
+
+
+def build_phantom_thd_cp_partition(
+    template: Datum,
+    *,
+    pad_multiple: int,
+    atomic_row_group_size: int = 1,
+) -> list[Datum]:
+    """Fabricate the masked synthetic datums for one phantom THD-CP partition.
+
+    F2: DP replicas pack a data-dependent number of real partitions, but the
+    per-partition MoE EP collectives span DP replicas whenever EP covers more
+    ranks than one replica — so replicas that disagree on the count deadlock.
+    The caller equalizes counts with an all-reduce MAX over the DP group;
+    short replicas append these phantom partitions as a strict suffix so every
+    rank executes the same number of per-partition collective sequences.
+
+    A phantom partition contributes EXACTLY zero loss, zero tokens, and zero
+    gradient (see the masking table above; MoE aux loss / load balancing are
+    force-disabled by the controller, so the router adds no side effects),
+    while still driving every collective the real path drives — kernels see a
+    legal minimal input of one ``pad_multiple``-token document, which is why
+    dummy tokens are used instead of a zero-token partition (empty cu_seqlens
+    / zero-row permute / all-zero grouped-GEMM splits are unvalidated).
+
+    ``template`` is any datum from the global batch (every rank receives it
+    via the dispatcher broadcast, so even a zero-datum replica can build
+    phantoms): it fixes WHICH loss inputs to fabricate. ``atomic_row_group_size``
+    keeps DPO-style paired losses packable (a phantom chosen/rejected pair).
+    """
+    if pad_multiple < 1:
+        raise ValueError(f"pad_multiple must be >= 1, got {pad_multiple}")
+    if atomic_row_group_size < 1:
+        raise ValueError(
+            f"atomic_row_group_size must be >= 1, got {atomic_row_group_size}"
+        )
+    seq_len = pad_multiple
+    # Always fabricate the universal CE mask pair, even when the template
+    # omits them: without ``target_tokens`` the packer would derive labels
+    # from the phantom's own tokens (all 1s → unmasked), and ``weights`` is
+    # the tinker-contract zero-contribution switch every loss fn respects or
+    # ignores harmlessly.
+    loss_fn_inputs = {
+        name: TensorData(
+            data=[_PHANTOM_LOSS_INPUT_VALUES[name][0]] * seq_len,
+            dtype=_PHANTOM_LOSS_INPUT_VALUES[name][1],
+            shape=[seq_len],
+        )
+        for name in ("target_tokens", "weights")
+    }
+    for name in template.loss_fn_inputs:
+        if name not in _PHANTOM_LOSS_INPUT_VALUES:
+            raise ValueError(
+                f"don't know how to fabricate a zero-contribution phantom "
+                f"value for loss input {name!r}; extend "
+                f"_PHANTOM_LOSS_INPUT_VALUES after auditing how the loss fn "
+                f"masks it"
+            )
+        value, dtype = _PHANTOM_LOSS_INPUT_VALUES[name]
+        loss_fn_inputs[name] = TensorData(
+            data=[value] * seq_len, dtype=dtype, shape=[seq_len]
+        )
+    phantom = Datum(
+        model_input=ModelInput.from_ints([1] * seq_len),
+        loss_fn_inputs=loss_fn_inputs,
+    )
+    return [phantom.model_copy(deep=True) for _ in range(atomic_row_group_size)]
+
