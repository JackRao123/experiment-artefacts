@@ -0,0 +1,251 @@
+"""F2 — phantom THD-CP partition tests (DP>1 deadlock fix).
+
+Section A (Mac/CPU-runnable, no megatron import): packing-level guarantees —
+phantom construction, zero-contribution masking, aggregation no-op, count
+partitioning.
+
+Section B (requires megatron.bridge; runs on-box / in CI): controller-level
+guarantees — env kill-switch, the DP MAX all-reduce (real gloo group), the
+per-partition loop's phantom-suffix skip, and the single-finalize ordering
+invariant (fibonacci review addition 2).
+
+The NaN×0 grad-corruption canary (fibonacci review addition 1a) needs a real
+GPU model forward+backward; it lives in the on-box validation recipe
+(f2_fix/ONBOX_VALIDATION_F2.md), not here.
+"""
+
+from __future__ import annotations
+
+import pytest
+import torch
+
+from loops_models.protocol import Datum, ModelInput, TensorData
+from trainers_server.dp_worker.api.packing import (
+    PackedMicrobatches,
+    aggregate_microbatch_metrics,
+    build_phantom_thd_cp_partition,
+    pack_thd_cp_microbatch,
+    partition_thd_cp_datums,
+    thd_cp_pad_multiple,
+)
+
+CP = 8  # matches the F2-relevant expB mesh (EP16/CP8/DP2)
+PAD = thd_cp_pad_multiple(cp_size=CP, tp_size=1)  # 16
+
+
+def _datum(tokens: list[int], **loss_inputs) -> Datum:
+    return Datum(
+        model_input=ModelInput.from_ints(tokens),
+        loss_fn_inputs={
+            name: TensorData(data=list(vals), dtype=dtype, shape=[len(tokens)])
+            for name, (vals, dtype) in loss_inputs.items()
+        },
+    )
+
+
+def _ce_template(seq_len: int = 100) -> Datum:
+    toks = [7] * seq_len
+    return _datum(
+        toks,
+        target_tokens=([5] * seq_len, "int64"),
+        weights=([1.0] * seq_len, "float32"),
+    )
+
+
+def _rl_template(seq_len: int = 100) -> Datum:
+    toks = [7] * seq_len
+    return _datum(
+        toks,
+        target_tokens=([5] * seq_len, "int64"),
+        logprobs=([-0.5] * seq_len, "float32"),
+        advantages=([0.3] * seq_len, "float32"),
+        temperatures=([1.0] * seq_len, "float32"),
+    )
+
+
+# ─── Section A: packing-level (Mac/CPU) ───────────────────────────────────
+
+
+class TestPhantomConstruction:
+    def test_ce_phantom_masks_everything(self):
+        phantom = build_phantom_thd_cp_partition(
+            _ce_template(), pad_multiple=PAD
+        )
+        assert len(phantom) == 1
+        d = phantom[0]
+        assert d.model_input.length == PAD
+        # Universal mask pair always fabricated…
+        assert set(d.loss_fn_inputs) >= {"target_tokens", "weights"}
+        assert all(v == -100 for v in d.loss_fn_inputs["target_tokens"].data)
+        assert all(v == 0.0 for v in d.loss_fn_inputs["weights"].data)
+
+    def test_rl_phantom_carries_rl_keys_zeroed(self):
+        phantom = build_phantom_thd_cp_partition(
+            _rl_template(), pad_multiple=PAD
+        )[0]
+        assert all(v == 0.0 for v in phantom.loss_fn_inputs["advantages"].data)
+        assert all(v == 0.0 for v in phantom.loss_fn_inputs["logprobs"].data)
+        assert all(v == 1.0 for v in phantom.loss_fn_inputs["temperatures"].data)
+        # …plus the universal CE mask pair.
+        assert all(v == -100 for v in phantom.loss_fn_inputs["target_tokens"].data)
+
+    def test_dpo_phantom_is_a_pair(self):
+        pair = build_phantom_thd_cp_partition(
+            _ce_template(), pad_multiple=PAD, atomic_row_group_size=2
+        )
+        assert len(pair) == 2
+        for d in pair:
+            assert all(v == 0.0 for v in d.loss_fn_inputs["weights"].data)
+
+    def test_unknown_loss_input_fails_loud(self):
+        bad = _datum([7] * 10, mystery_field=([1.0] * 10, "float32"))
+        with pytest.raises(ValueError, match="zero-contribution phantom"):
+            build_phantom_thd_cp_partition(bad, pad_multiple=PAD)
+
+    def test_phantom_packs_through_the_real_path(self):
+        """The phantom must be a legal input to pack_thd_cp_microbatch itself."""
+        phantom = build_phantom_thd_cp_partition(_rl_template(), pad_multiple=PAD)
+        packed = pack_thd_cp_microbatch(
+            phantom,
+            max_length=131072,
+            cp_size=CP,
+            device=torch.device("cpu"),
+            pad_multiple=PAD,
+        )
+        assert packed.global_seq_len == PAD
+        assert packed.cu_seqlens.tolist() == [0, PAD]
+        assert (packed.labels == -100).all()
+        assert (packed.weights == 0).all()
+        assert (packed.advantages == 0).all()
+        # One tiny document, well-formed for every downstream kernel.
+        assert packed.max_seqlen == PAD
+        assert packed.local_seq_len == PAD // CP
+
+
+class TestPartitionCounting:
+    """The data-dependent count the DP all-reduce MAX equalizes (F2 mechanism)."""
+
+    def test_count_is_data_dependent(self):
+        # 1000-token datums, pad_multiple 16, max_length 2048: two full
+        # partitions + a tail — vs one partition when max_length grows.
+        data = [_ce_template(1000) for _ in range(3)]
+        parts = partition_thd_cp_datums(
+            data, max_length=2048, cp_size=CP, pad_multiple=PAD
+        )
+        assert len(parts) == 2  # 1008-token padded docs: 2 fit, 1 spills
+        parts = partition_thd_cp_datums(
+            data, max_length=4096, cp_size=CP, pad_multiple=PAD
+        )
+        assert len(parts) == 1
+
+    def test_empty_slice_packs_zero_partitions(self):
+        # The boot-warmup deadlock case: dp_rank1's slice data[1:1] is empty.
+        assert (
+            partition_thd_cp_datums([], max_length=2048, cp_size=CP, pad_multiple=PAD)
+            == []
+        )
+
+
+class TestAggregationNoOp:
+    def test_zero_zero_report_is_a_no_op(self):
+        real = {"loss": torch.tensor([6.0, 3.0])}  # sum=6 over 3 tokens
+        with_phantom = aggregate_microbatch_metrics(
+            [real, {"loss": torch.tensor([0.0, 0.0])}],
+            real_n=1,
+            num_microbatches=2,
+        )
+        without = aggregate_microbatch_metrics([real], real_n=1, num_microbatches=1)
+        assert with_phantom == without
+
+    def test_packed_microbatches_default_has_no_phantoms(self):
+        packed = PackedMicrobatches(microbatches=[], pre_split_rows=0)
+        assert packed.phantom_partitions == 0
+
+
+# ─── Section B: controller-level (needs megatron.bridge; on-box / CI) ─────
+
+try:
+    import megatron.bridge  # noqa: F401
+    from trainers_server.dp_worker.api import megatron_controller as mc_mod
+
+    _HAS_MC = True
+except ImportError:
+    mc_mod = None
+    _HAS_MC = False
+
+needs_megatron = pytest.mark.skipif(
+    not _HAS_MC, reason="controller import needs megatron (on-box / CI only)"
+)
+
+
+@needs_megatron
+class TestEnvGate:
+    def test_default_on(self, monkeypatch):
+        monkeypatch.delenv("BT_F2_PHANTOM_PARTITIONS", raising=False)
+        assert mc_mod._phantom_partitions_enabled()
+
+    def test_kill_switch(self, monkeypatch):
+        monkeypatch.setenv("BT_F2_PHANTOM_PARTITIONS", "0")
+        assert not mc_mod._phantom_partitions_enabled()
+
+
+@needs_megatron
+class TestDpMaxPartitionCount:
+    def test_identity_without_dist(self):
+        assert mc_mod._dp_max_partition_count(3) == 3
+
+    @pytest.mark.skipif(
+        not torch.distributed.is_gloo_available(), reason="needs gloo"
+    )
+    def test_max_over_real_gloo_group(self, tmp_path, monkeypatch):
+        """2-proc CPU gloo group: counts (3, 2) must both observe 3."""
+        import torch.multiprocessing as mp
+
+        def _worker(rank, path, out):
+            torch.distributed.init_process_group(
+                "gloo", init_method=f"file://{path}", rank=rank, world_size=2
