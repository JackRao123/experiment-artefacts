+def _probs_a2a_comm_v2_enabled() -> bool:
+    """Lazy env-gate read for the W1-v2 paired dispatch node.
+
+    BT_MOE_PROBS_A2A_COMM_V2=1 requires BT_MOE_PROBS_A2A_COMM=1 (the second
+    communicator); it swaps the two separate deferred A2A nodes for one paired
+    node whose backward issues both reverses back-to-back (engine order can no
+    longer separate them). Ship-gated on hilbert's launch-vs-kernel-start cut
+    AND the grad-arrival measurement (see overlap_design/patches/
+    W1V2_PATCH_NOTES.md): under probs-grad-late readiness drift the paired
+    node would delay the tokens reverse — correct but potentially slower.
+    """
+    enabled = os.environ.get("BT_MOE_PROBS_A2A_COMM_V2", "0") == "1"
+    if not _PROBS_A2A_COMM_V2_GATE_LOGGED[0]:
+        _PROBS_A2A_COMM_V2_GATE_LOGGED[0] = True
+        if enabled and _probs_a2a_comm_enabled():
+            logger.warning(
+                "BT_MOE_PROBS_A2A_COMM_V2=1: paired dispatch node (single-node "
+                "tokens+probs, back-to-back reverses in backward) ACTIVE"
+            )
+        elif enabled:
+            logger.warning(
+                "BT_MOE_PROBS_A2A_COMM_V2=1 ignored: BT_MOE_PROBS_A2A_COMM is not enabled"
+            )
+    return enabled and _probs_a2a_comm_enabled()
