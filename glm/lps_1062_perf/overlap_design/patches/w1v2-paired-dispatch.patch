+def _issue_all_to_all_single_async(group, input, output_split_sizes, input_split_sizes):
+    """Allocate the output and issue an all_to_all_single asynchronously.
+
+    Shared by _AllToAllDeferredWait and _AllToAllDeferredWaitPair. Returns
+    (output, work); world_size == 1 bypasses to (input, None).
+    """
+    if group.size() == 1:
+        return input, None
+    input = input.contiguous()
+    if output_split_sizes is None:
+        output = torch.empty_like(input)
+    else:
+        # new_empty inherits input's device (device-agnostic, CPU-testable).
+        output = input.new_empty(
+            size=[sum(output_split_sizes)] + list(input.size()[1:]),
+            dtype=input.dtype,
+        )
+    work = torch.distributed.all_to_all_single(
+        output,
+        input,
+        output_split_sizes=output_split_sizes,
+        input_split_sizes=input_split_sizes,
+        group=group,
+        async_op=True,
+    )
+    return output, work
+
