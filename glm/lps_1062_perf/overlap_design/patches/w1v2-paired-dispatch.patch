+def all_to_all_deferred_pair(
+    group_tokens, group_probs, input_tokens, input_probs, output_split_sizes_, input_split_sizes
+):
+    """Wrapper for the paired deferred-wait all-to-alls (BT_MOE_PROBS_A2A_COMM v2).
+
+    One autograd node issues both collectives (tokens on group_tokens, probs
+    on group_probs); both waits are deferred to the caller. Backward issues
+    both reverses back-to-back inside the single node. NOTE: the node's
+    backward fires only when BOTH output grads have arrived — see the
+    readiness-coupling note in W1_PATCH_NOTES.md / the W1-v2 notes.
+    """
+    assert group_tokens is not None, "group_tokens should not be None"
+    assert group_probs is not None, "group_probs should not be None"
+    return _AllToAllDeferredWaitPair.apply(
+        group_tokens,
+        group_probs,
+        input_tokens,
+        input_probs,
+        output_split_sizes_,
+        input_split_sizes,
+    )
+
