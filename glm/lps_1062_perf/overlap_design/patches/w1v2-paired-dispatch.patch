+class _AllToAllDeferredWaitPair(torch.autograd.Function):
+    """BT_MOE_PROBS_A2A_COMM v2: the tokens and probs dispatch all-to-alls as
+    ONE autograd node.
+
+    Forward issues both collectives asynchronously (tokens on the EP
+    communicator, probs on the second communicator) and defers both waits to
+    the caller (wait_deferred_a2a), exactly like two _AllToAllDeferredWait
+    calls. Backward issues BOTH reverse all-to-alls back-to-back inside the
+    single node's backward — the autograd engine's execution order can no
+    longer separate the two reverses (the measured W1 backward-window defect:
+    the probs reverse executing late). This is the mechanism-proof form of the
+    seq-bump alternative: construction order already assigns the two separate
+    nodes adjacent sequence numbers (verified: tokens=N, probs=N+1, and the
+    probs reverse executes first), so re-anchoring sequence numbers is inert;
+    fusing the node removes the engine-ordering degree of freedom entirely.
+
+    Numerics: bitwise-identical to the two separate deferred calls (same
+    messages on the same communicators, same waits).
+    """
+
+    @staticmethod
+    def forward(
+        ctx,
+        group_tokens,
+        group_probs,
+        input_tokens,
+        input_probs,
+        output_split_sizes,
+        input_split_sizes,
+    ):
+        """Issue both all-to-alls asynchronously; stash each work on its output."""
+        ctx.group_tokens = group_tokens
+        ctx.group_probs = group_probs
+        ctx.output_split_sizes = output_split_sizes
+        ctx.input_split_sizes = input_split_sizes
+        out_tokens, work_t = _issue_all_to_all_single_async(
+            group_tokens, input_tokens, output_split_sizes, input_split_sizes
+        )
+        out_probs, work_p = _issue_all_to_all_single_async(
+            group_probs, input_probs, output_split_sizes, input_split_sizes
+        )
+        if work_t is not None:
+            setattr(out_tokens, _DEFERRED_A2A_WORK_ATTR, work_t)
+        if work_p is not None:
+            setattr(out_probs, _DEFERRED_A2A_WORK_ATTR, work_p)
+        return out_tokens, out_probs
+
+    @staticmethod
+    def backward(ctx, grad_tokens, grad_probs):
+        """Issue both reverse all-to-alls back-to-back, then wait both."""
+        grad_input_tokens, work_t = _issue_all_to_all_single_async(
+            ctx.group_tokens,
+            grad_tokens,
+            ctx.input_split_sizes,
+            ctx.output_split_sizes,
+        )
+        grad_input_probs, work_p = _issue_all_to_all_single_async(
+            ctx.group_probs,
+            grad_probs,
+            ctx.input_split_sizes,
+            ctx.output_split_sizes,
+        )
+        if work_t is not None:
+            work_t.wait()
+        if work_p is not None:
+            work_p.wait()
+        return None, None, grad_input_tokens, grad_input_probs, None, None
+
+
